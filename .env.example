NODE_ENV=development

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bogaap
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bogaap?schema=public

REDIS_URL=redis://localhost:6379

API_HOST=0.0.0.0
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
API_CORS_MODE=development
FRONTEND_PUBLIC_URL=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_API_PROXY_ORIGIN=http://localhost:3001
AUTH_COOKIE_SECURE=false

STORAGE_DRIVER=minio
STORAGE_BUCKET=bogaap-dev
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=bogaap_minio
STORAGE_SECRET_ACCESS_KEY=bogaap_minio_dev_12345
STORAGE_FORCE_PATH_STYLE=true

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

ATTACHMENT_UPLOAD_RATE_LIMIT_MAX=3
ATTACHMENT_UPLOAD_RATE_LIMIT_WINDOW_MS=60000
