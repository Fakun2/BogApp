{
  "name": "@bogaap/database",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed:rbac": "node prisma/seed-rbac.cjs",
    "db:prepare": "prisma migrate deploy && npm run db:seed:rbac",
    "db:studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "prisma": "^6.19.0"
  }
}
