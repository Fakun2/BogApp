
# Copy this file to .env.production on the VPS and replace every CHANGE_ME value.

CONTAINER_PREFIX=bogaap-prod

# Public URLs
PUBLIC_DOMAIN=app.bogaap.example
FRONTEND_PUBLIC_URL=https://app.bogaap.example
API_PUBLIC_URL=https://app.bogaap.example/api
API_CORS_ALLOWED_ORIGINS=https://app.bogaap.example

# PostgreSQL
POSTGRES_USER=bogaap
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=bogaap

# Auth
JWT_ACCESS_SECRET=CHANGE_ME_64_CHAR_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_RANDOM_REFRESH_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# API runtime
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
EXPENSE_OVERDUE_SCHEDULER_ENABLED=true
ATTACHMENT_UPLOAD_RATE_LIMIT_MAX=20
ATTACHMENT_UPLOAD_RATE_LIMIT_WINDOW_MS=60000

# Storage: self-hosted MinIO by default.
# For Vultr Object Storage or another S3-compatible provider, update endpoint/region
# and consider removing the minio/minio-init services from docker-compose.prod.yml.
STORAGE_DRIVER=minio
STORAGE_BUCKET=bogaap-prod
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY_ID=CHANGE_ME_STORAGE_ACCESS_KEY
STORAGE_SECRET_ACCESS_KEY=CHANGE_ME_STORAGE_SECRET_KEY
STORAGE_FORCE_PATH_STYLE=true

# Optional seed for Estudio Moreira
MOREIRA_USER_EMAIL=ejemplo@gmail.com
MOREIRA_USER_PASSWORD=CHANGE_ME_INITIAL_MOREIRA_PASSWORD
MOREIRA_USER_FULL_NAME=Usuario Moreira
MOREIRA_TENANT_NAME=Estudio Moreira
MOREIRA_TENANT_LEGAL_NAME=Estudio Juridico Moreira
MOREIRA_TENANT_TAX_ID=20999999992
