# Copy this file to .env.production on the VPS and replace every CHANGE_ME value.

CONTAINER_PREFIX=

# Public URLs
PUBLIC_DOMAIN=
FRONTEND_PUBLIC_URL=
API_PUBLIC_URL=
API_CORS_ALLOWED_ORIGINS=

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Auth
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=
JWT_REFRESH_TTL=

# API runtime
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=
EXPENSE_OVERDUE_SCHEDULER_ENABLED=
ATTACHMENT_UPLOAD_RATE_LIMIT_MAX=
ATTACHMENT_UPLOAD_RATE_LIMIT_WINDOW_MS=

# Storage: self-hosted MinIO by default.
# For Vultr Object Storage or another S3-compatible provider, update endpoint/region
# and consider removing the minio/minio-init services from docker-compose.prod.yml.
STORAGE_DRIVER=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=

# Optional seed for Estudio Moreira
MOREIRA_USER_EMAIL=
MOREIRA_USER_PASSWORD=
MOREIRA_USER_FULL_NAME=
MOREIRA_TENANT_NAME=
MOREIRA_TENANT_LEGAL_NAME=
MOREIRA_TENANT_TAX_ID=
