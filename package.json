{
  "name": "bogaap",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --parallel",
    "dev:lan": "turbo dev:lan --parallel",
    "dev:api": "npm run dev --workspace @bogaap/api",
    "dev:web": "npm run dev --workspace @bogaap/web",
    "build": "turbo build",
    "start": "turbo start --parallel",
    "start:lan": "turbo start:lan --parallel",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test:e2e": "turbo test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,css,yml,yaml,prisma}\" --ignore-unknown",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,css,yml,yaml,prisma}\" --ignore-unknown",
    "api:openapi": "npm run openapi --workspace @bogaap/api",
    "api-client:generate": "npm run generate --workspace @bogaap/api-client",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:seed:rbac": "node packages/database/prisma/seed-rbac.cjs",
    "db:prepare": "prisma migrate deploy --schema packages/database/prisma/schema.prisma && npm run db:seed:rbac",
    "db:studio": "prisma studio --schema packages/database/prisma/schema.prisma",
    "docker:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/docker-up.ps1",
    "docker:up:detached": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/docker-up.ps1 -d",
    "docker:dev:infra": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/docker-dev-infra.ps1",
    "docker:down": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/docker-down.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
