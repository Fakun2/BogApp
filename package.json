{
  "name": "bogaap",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/with-root-env.cjs turbo dev --parallel",
    "dev:lan": "node scripts/with-root-env.cjs turbo dev:lan --parallel",
    "dev:api": "node scripts/with-root-env.cjs npm run dev --workspace @bogaap/api",
    "dev:web": "node scripts/with-root-env.cjs npm run dev --workspace @bogaap/web",
    "build": "turbo build",
    "start": "turbo start --parallel",
    "start:lan": "turbo start:lan --parallel",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test:e2e": "turbo test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,css,yml,yaml,prisma}\" --ignore-unknown",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,css,yml,yaml,prisma}\" --ignore-unknown",
    "api:openapi": "npm run openapi --workspace @bogaap/api",
    "api-client:generate": "npm run generate --workspace @bogaap/api-client",
    "db:generate": "node scripts/with-root-env.cjs prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "node scripts/with-root-env.cjs prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:seed:rbac": "node scripts/with-root-env.cjs node packages/database/prisma/seed-rbac.cjs",
    "db:seed:practice-area-templates": "node scripts/with-root-env.cjs node packages/database/prisma/seed-practice-area-templates.cjs",
    "db:seed:legal-catalogs": "node scripts/with-root-env.cjs node packages/database/prisma/seed-legal-catalogs.cjs",
    "db:seed:demo": "node scripts/with-root-env.cjs node packages/database/prisma/seed-demo-data.cjs",
    "db:clear:demo": "node scripts/with-root-env.cjs node packages/database/prisma/clear-demo-data.cjs",
    "db:copy-data": "node scripts/db-copy-data.cjs",
    "db:prepare": "node scripts/with-root-env.cjs prisma migrate deploy --schema packages/database/prisma/schema.prisma && npm run db:seed:rbac && npm run db:seed:practice-area-templates && npm run db:seed:legal-catalogs",
    "db:studio": "node scripts/with-root-env.cjs prisma studio --schema packages/database/prisma/schema.prisma",
    "docker:up": "node scripts/docker.cjs up",
    "docker:up:detached": "node scripts/docker.cjs up --detached",
    "docker:recreate": "node scripts/docker.cjs recreate",
    "docker:dev:infra": "node scripts/docker.cjs infra",
    "docker:dev:down": "node scripts/docker.cjs infra:down",
    "docker:down": "node scripts/docker.cjs down"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "dotenv": "^16.4.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
