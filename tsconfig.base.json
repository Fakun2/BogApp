{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@bogaap/database": ["packages/database/src"],
      "@bogaap/api-client": ["packages/api-client/src"],
      "@bogaap/ai-contracts": ["packages/ai-contracts/src"],
      "@bogaap/ai-core": ["packages/ai-core/src"]
    }
  }
}
